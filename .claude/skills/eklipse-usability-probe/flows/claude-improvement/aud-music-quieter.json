{
  "id": "aud-music-quieter",
  "flow": "A2",
  "menu": "Audio",
  "persona": "quick-user",
  "target": "claude-improvement",
  "weight": 0.2,
  "mission": "Add background music, then turn it down low so your voice stays clear over it. About a third of full volume or lower, but not muted. Export it.",
  "start": {
    "screen": "L00"
  },
  "checkpoints": [
    {
      "id": "music",
      "check": "state.audio.some(x => x.category === 'Music')",
      "describe": "A song is on the clip"
    },
    {
      "id": "quiet",
      "check": "state.audio.some(x => x.category === 'Music' && x.volume > 0 && x.volume <= 40)",
      "describe": "The song is quiet but still audible"
    },
    {
      "id": "export",
      "check": "state.exported === true",
      "describe": "The clip export has finished"
    }
  ],
  "bestPath": [
    {
      "do": "click",
      "selector": ".rail nav button:has-text('Audio')"
    },
    {
      "do": "click",
      "selector": ".audio-tabs button:nth-child(2)"
    },
    {
      "do": "click",
      "selector": ".audio-row-title"
    },
    {
      "do": "click",
      "selector": "input[aria-label='Volume']",
      "positionRatio": 0.3
    },
    {
      "do": "click",
      "selector": ".tb-primary"
    },
    {
      "do": "click",
      "selector": ".export-primary"
    }
  ],
  "bestTimeSeconds": null,
  "budget": {
    "minutes": 12
  },
  "why": {
    "data": "Quick users take the first plausible control and keep defaults; music is on only a small share of projects (3.8% among heavy editors), so the volume control is the free adjustment tested.",
    "source": "plans/261027-usability-probe-skill/personas.md"
  },
  "input": {
    "clip": null
  },
  "playerIds": [
    "quick-match",
    "quick-differs"
  ]
}
