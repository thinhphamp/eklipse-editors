{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Player",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "persona",
    "scenario",
    "behavior"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "persona": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "scenario": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "behavior": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    }
  }
}
