{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Probe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "feature",
    "personaRefs",
    "target",
    "start",
    "goal",
    "success",
    "budget",
    "bestPath",
    "why",
    "holdout"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "feature": {
      "type": "string",
      "minLength": 1
    },
    "personaRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "screen"
      ],
      "properties": {
        "screen": {
          "type": "string",
          "minLength": 1
        },
        "storage": {
          "type": "object"
        }
      }
    },
    "goal": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check",
        "describe"
      ],
      "properties": {
        "check": {
          "type": "string",
          "minLength": 3
        },
        "describe": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps",
        "scrolls",
        "minutes"
      ],
      "properties": {
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "scrolls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "minutes": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 20
        }
      }
    },
    "bestPath": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "do"
        ],
        "properties": {
          "do": {
            "enum": [
              "click",
              "type",
              "key",
              "scroll",
              "drag"
            ]
          },
          "role": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "dy": {
            "type": "number"
          },
          "to": {
            "type": "string"
          }
        }
      }
    },
    "why": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "source"
      ],
      "properties": {
        "data": {
          "type": "string",
          "minLength": 5
        },
        "source": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "holdout": {
      "type": "boolean"
    },
    "variant": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "notes": {
      "type": "string"
    },
    "scenario": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "firstClickAlso": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
