{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Persona",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "rank", "name", "experience", "behavior", "knows", "does_not_know", "patience", "words", "tier", "fixtures", "provenance"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "rank": { "type": "integer", "minimum": 1, "maximum": 20 },
    "name": { "type": "string", "minLength": 3 },
    "experience": { "enum": ["new", "first-time", "returning", "power"] },
    "behavior": { "type": "string", "minLength": 10 },
    "knows": { "type": "array", "items": { "type": "string" } },
    "does_not_know": { "type": "array", "items": { "type": "string" } },
    "patience": { "enum": ["low", "medium", "high"] },
    "words": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "tier": { "enum": ["free", "new", "light", "legacy-premium", "standard", "power", "pro"] },
    "fixtures": {
      "type": "object", "additionalProperties": false,
      "properties": { "storage": { "type": "object" } }
    },
    "provenance": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
